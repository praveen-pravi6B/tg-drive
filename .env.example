# Telegram API credentials from https://my.telegram.org -> App configuration
# These are compiled into the client bundle (unavoidable for a serverless
# MTProto app), so use a dedicated app for TGDrive.
VITE_TG_API_ID=0
VITE_TG_API_HASH=

# Optional: override defaults at build time
# VITE_TG_CHUNK_SIZE=20971520
